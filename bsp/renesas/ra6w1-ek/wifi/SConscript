import os

from building import *

Import('RTT_ROOT')
Import('rtconfig')

cwd = GetCurrentDir()
bsp_root = os.path.dirname(cwd)
wrapper_root = os.path.join(bsp_root, 'packages', 'FreeRTOS_Wrapper-latest', 'FreeRTOS')
sdk_root = os.path.join(cwd, 'supplicant', 'sdk')


def w(*parts):
    return os.path.join(cwd, *parts)


def collect_c(root):
    result = []
    for current, dirs, files in os.walk(root):
        dirs.sort()
        for name in sorted(files):
            if name.endswith('.c'):
                result.append(os.path.join(current, name))
    return result


def collect_dirs(root):
    result = []
    for current, dirs, files in os.walk(root):
        result.append(current)
    return result


