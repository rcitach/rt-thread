for root in [
    w('platform', 'fsp_inc'),
    w('platform', 'rm_wifi'),
    w('platform', 'rm_vee_flash_w'),
    w('platform', 'rm_map_persistant_w'),
    w('platform', 'rm_block_media_spi_w'),
    w('platform', 'rm_watchdog_service_w'),
    w('platform', 'rm_comms_lock'),
    w('platform', 'rm_comms_uart_w'),
    w('platform', 'rm_mbedtls'),
    w('platform', 'rm_psa_crypto_w'),
    w('platform', 'r_cc312_openable_w'),
    sdk_root,
]:
    include_roots += collect_dirs(root)

include_roots = sorted(set(include_roots))

cppdefines = [
    'PKG_FREERTOS_USING_CONFIG_H',
    'RM_MAP_PERSISTANT_W',
    'OS_FREERTOS',
    'RM_LWIP_W',
    '__SUPPORT_IPV4__',
    '__SUPPORT_IPV6__',
    '__SUPPORT_DHCP_SVR__',
    'RA6W1_WIFI_BASIC_SCAN',
]

cpppath = include_roots
group = []
group += DefineGroup('WiFiPlatform', src_platform, depend=[''],
                     CPPPATH=[w('config')],
                     LOCAL_CPPPATH=cpppath, LOCAL_CPPDEFINES=cppdefines)
group += DefineGroup('WiFiSDK', src_sdk, depend=[''],
                     LOCAL_CPPPATH=cpppath, LOCAL_CPPDEFINES=cppdefines)
group += DefineGroup('WiFiLwIPAdapter', src_wifi_lwip, depend=['RT_USING_LWIP'],
                     LOCAL_CPPPATH=cpppath, LOCAL_CPPDEFINES=cppdefines)
group += DefineGroup('WiFiCrypto', src_crypto, depend=[''],
                     LOCAL_CPPPATH=cpppath, LOCAL_CPPDEFINES=cppdefines,
                     LOCAL_CCFLAGS='-Os')
group += DefineGroup('WiFiRTOSHal', src_rtos_hal, depend=[''],
                     LOCAL_CPPPATH=cpppath, LOCAL_CPPDEFINES=cppdefines)
group += DefineGroup('WiFiApp', src_app, depend=[''],
                     LOCAL_CPPPATH=cpppath, LOCAL_CPPDEFINES=cppdefines)

# The archives contain the MAC, ROMAC, driver and supplicant implementation.
driver_libs = ['macsw', 'rwnx_drv', 'romaclib', 'supplicant', 'r_cc312_property_w']
group += DefineGroup('WiFiDriver', [], depend=[''],
                     LIBPATH=[w('driver')], LIBS=driver_libs,
                     # Keep the MIB object reachable after the CLI sources are removed.
                     LINKFLAGS=' -Wl,-u,machw_mib')

Return('group')
